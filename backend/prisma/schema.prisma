generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  TV
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  WATCHED
  DROPPED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  entries      WatchEntry[]
}

model WatchEntry {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId     Int
  mediaType  MediaType
  title      String
  posterPath String?
  status     WatchStatus @default(PLAN_TO_WATCH)
  rating     Int?
  notes      String?
  watchedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, status])
}